@inherits LayoutComponentBase
@inject AuthState Auth

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Auth.IsLoggedIn)
            {
                <span class="text-muted">@Auth.Email</span>
            }
            else
            {
                <a href="login">Login</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
