@model JobApplicationFormViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit application</h1>

<form asp-action="Edit"
      method="post"
      class="card">

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">
        <button type="submit"
                class="button primary">
            Save
        </button>

        <a class="button"
           asp-action="Index">
            Cancel
        </a>
    </div>
</form>
