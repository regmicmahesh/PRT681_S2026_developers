@model IEnumerable<BookStoreApp.DAL.Printer>

@{
    ViewData["Title"] = "Printers";
}

<h1>Printers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Printer
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var printer in Model)
        {
            <tr>
                <td>@printer.Name</td>
                <td>@printer.Brand</td>
                <td>@printer.Model</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@printer.Id"
                       class="btn btn-sm btn-warning">Edit</a>

                    <a asp-action="Details"
                       asp-route-id="@printer.Id"
                       class="btn btn-sm btn-info">Details</a>

                    <a asp-action="Delete"
                       asp-route-id="@printer.Id"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>