@model BookStoreApp.DAL.Printer

@{
    ViewData["Title"] = "Delete Printer";
}

<h1>Delete Printer</h1>

<h3>Are you sure you want to delete this printer?</h3>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Brand</dt>
    <dd class="col-sm-10">@Model.Brand</dd>

    <dt class="col-sm-2">Model</dt>
    <dd class="col-sm-10">@Model.Model</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>
</form>